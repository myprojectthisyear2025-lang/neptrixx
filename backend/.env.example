# Render environment variables. Replace every REPLACE value; never commit actual credentials.
NODE_ENV=production
# The only feature switch: false hides/stops support without deleting its data.
SUPPORT_ENABLED=true
CLIENT_ORIGIN=https://neptrixx.com,https://www.neptrixx.com
MONGODB_URI=REPLACE_MONGODB_CONNECTION_STRING
MONGODB_DB_NAME=neptrixx
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RESEND_API_KEY=REPLACE_RESEND_API_KEY
EMAIL_FROM=Neptrixx <notifications@neptrixx.com>
EMAIL_REPLY_TO=support@neptrixx.com
INQUIRY_FROM_EMAIL=Neptrixx <notifications@neptrixx.com>
INQUIRY_TO_EMAIL=neptrixxinternational@gmail.com
R2_ACCOUNT_ID=REPLACE_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=REPLACE_PRIVATE_BUCKET_NAME
WEB_PUSH_PUBLIC_KEY=REPLACE_VAPID_PUBLIC_KEY
WEB_PUSH_PRIVATE_KEY=REPLACE_VAPID_PRIVATE_KEY
WEB_PUSH_SUBJECT=mailto:support@neptrixx.com
INITIAL_ADMIN_EMAIL=REPLACE_YOUR_ADMIN_EMAIL
